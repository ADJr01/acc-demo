
{{!-- Input Area --}}
<div class="input-area">
  <div class="input-wrapper">
    <div class="input-actions">
      <button class="input-btn" title="Add Attachment" type="button">
        <FaIcon @icon="link"  @title="Attachment"  />
      </button>
    </div>
    <textarea
      class="message-input"
      placeholder="Type your message here..."
      rows="1"
      id="messageInput"
    ></textarea>
    <button class="send-btn" id="sendBtn" title="Send Message" type="button">
      <FaIcon @icon="microphone"  @title="send"  />
    </button>
    <button class="send-btn" id="sendBtn" title="Send Message" type="button">
      <FaIcon @icon="paper-plane"  @title="send"  />
    </button>
  </div>
</div>