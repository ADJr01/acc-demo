
{{!-- Input Area --}}
<div class="input-area">
  <div class="input-wrapper">
    <div class="input-actions">
      <button class="input-btn" title="Add Attachment" type="button" {{on 'click' this.onFileAttachIconClick}}>
        <FaIcon @icon="link"  @title="Attachment"  />
      </button>
    </div>
    <textarea
      class="message-input"
      placeholder="Type your message here..."
      rows="1"
      id="messageInput"
    ></textarea>
    <button class="record-btn" id="sendBtn" title="Send Message" type="button">
      <FaIcon @icon="microphone"  @title="send"  />
    </button>
    <button class="send-btn" id="sendBtn" title="Send Message" type="button">
      <FaIcon @icon="paper-plane"  @title="send"  />
    </button>
  </div>
  <input
    id="chat_attachment"
    style="display: none"
    type="file"
    accept=".txt,text/plain,
          .pdf,application/pdf,
          .doc,.docx,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,
          .xls,.xlsx,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,
          image/*"
    multiple={{true}}
    maxlength={{3}}
    {{on 'change' this.onFileItemChange}}
  />
</div>