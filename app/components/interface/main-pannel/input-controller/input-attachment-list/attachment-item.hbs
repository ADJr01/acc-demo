<div class="file_attachment">
  <div class="file_attachment_delete">
    <FaIcon @icon="trash"   @title="{{@attachment.name}}"  />
  </div>
  {{#if this.is_image_attachment}}
      <img src={{this.render_image}} width="32px" height="32px" style="object-fit: cover" loading="lazy" title="{{@attachment.name}}">
    {{else}}
      <FaIcon @icon="file"  @title="{{@attachment.name}}"  />
    {{/if}}
</div>